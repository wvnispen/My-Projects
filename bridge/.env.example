# CommsGateway — Environment Configuration
# Copy to .env and fill in all values before starting the service.
# deploy.sh auto-generates API_KEY and WAHA_API_KEY — keep them.

# ── API security ───────────────────────────────────────────────────────────
API_KEY=CHANGE_ME_API_KEY

# ── ESP32 device ───────────────────────────────────────────────────────────
ESP32_URL=http://192.168.1.100        # static IP / DHCP reservation of the board
ESP32_TIMEOUT=10                      # seconds before giving up

# ── Telegram ───────────────────────────────────────────────────────────────
# Get token from @BotFather → /newbot
# Get chat_id: send a message to the bot, then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=            # used when 'to' is empty in the request

# ── WhatsApp (WAHA) ────────────────────────────────────────────────────────
WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=CHANGE_ME_WAHA_KEY
WAHA_SESSION=default
# Default number in international format without + (e.g. 27821234567)
WAHA_DEFAULT_NUMBER=

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
