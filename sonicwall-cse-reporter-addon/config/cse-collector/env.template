# SonicWall CSE Collector Environment File
# /etc/cse-collector/env
#
# This file stores the CSE API key securely
# Set permissions: chmod 600 /etc/cse-collector/env

# CSE API Key from Command Center (Settings > API Keys)
# Create a ReadOnly scoped key named "CSE-Reporter"
CSE_API_KEY=your-api-key-secret-here
