[Unit]
Description=SonicWall CSE Events Collector
Documentation=https://github.com/wvnispen/sonicwall-cse-reporter-addon
After=network-online.target loki.service
Wants=network-online.target

[Service]
Type=simple
User=cse-collector
Group=cse-collector
ExecStart=/usr/bin/python3 /opt/cse-collector/cse-collector.py
Restart=always
RestartSec=10

# Environment file for API key (more secure than config file)
EnvironmentFile=-/etc/cse-collector/env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/cse-collector /var/log/cse-collector

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cse-collector

[Install]
WantedBy=multi-user.target
