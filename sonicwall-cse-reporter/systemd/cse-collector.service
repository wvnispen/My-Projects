[Unit]
Description=SonicWall CSE Events Collector
After=network-online.target loki.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/cse-collector/cse-collector.py
Restart=always
RestartSec=10
EnvironmentFile=-/etc/cse-collector/env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cse-collector
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
