# CommsGateway — Environment Configuration
# Copy to .env and fill in all values before starting the service.
# deploy.sh auto-generates API_KEY and WAHA_API_KEY — keep them.
# IMPORTANT: no inline comments — put comments on their own line only.

# ── API security ───────────────────────────────────────────────────────────
API_KEY=CHANGE_ME_API_KEY

# ── ESP32 device ───────────────────────────────────────────────────────────
# Set to the static IP / DHCP reservation of the ESP32 board
ESP32_URL=http://192.168.1.100
# Seconds to wait before giving up on the ESP32
ESP32_TIMEOUT=10

# ── Telegram ───────────────────────────────────────────────────────────────
# Get token from @BotFather → /newbot
# Get chat_id: send a message to the bot, then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
# Used when 'to' is empty in the send request
TELEGRAM_DEFAULT_CHAT_ID=

# ── WhatsApp (WAHA) ────────────────────────────────────────────────────────
WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=CHANGE_ME_WAHA_KEY
WAHA_SESSION=default
# Default number in international format without + (e.g. 27821234567)
WAHA_DEFAULT_NUMBER=

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
