# SonicWall Flow Reporter - Environment Configuration
# Copy this file to .env and customize values

# ============================================================================
# Elasticsearch Configuration
# ============================================================================
ELASTIC_PASSWORD=changeme-strong-password-here
ES_JAVA_OPTS=-Xms2g -Xmx2g

# ============================================================================
# Grafana Configuration
# ============================================================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-password

# ============================================================================
# Identity UI Configuration
# ============================================================================
IDENTITY_ADMIN_USER=admin
IDENTITY_ADMIN_PASSWORD=changeme-identity-password
SECRET_KEY=generate-a-random-32-char-string-here

# ============================================================================
# SonicWall SSO Integration (Optional)
# ============================================================================
# Set these to enable automatic user-to-IP sync from SonicWall
SONICWALL_SSO_ENABLED=false
SONICWALL_HOST=192.168.1.1
SONICWALL_API_PORT=443
SONICWALL_API_USER=admin
SONICWALL_API_PASSWORD=your-firewall-password
SONICWALL_SSO_SYNC_INTERVAL=300

# ============================================================================
# IPFIX Collector Configuration
# ============================================================================
IPFIX_LISTEN_IP=0.0.0.0
IPFIX_LISTEN_PORT=2055

# Comma-separated list of allowed firewall IPs (empty = allow all)
IPFIX_ALLOWED_SOURCES=

# ============================================================================
# Data Retention (days)
# ============================================================================
RETENTION_RAW_DAYS=30
RETENTION_HOURLY_DAYS=90
RETENTION_DAILY_DAYS=365

# ============================================================================
# Timezone
# ============================================================================
TZ=Africa/Johannesburg
